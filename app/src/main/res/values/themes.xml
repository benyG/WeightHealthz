<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thème de la fenêtre avant que Compose ne prenne la main : mêmes couleurs que le thème
        Compose, pour que le lancement n'affiche pas un flash blanc avant le graphite.
    -->
    <style name="Theme.Forge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
