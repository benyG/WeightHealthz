<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".ForgeWearApplication"
        android:allowBackup="false"
        android:label="Forge"
        android:supportsRtl="true">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!--
            L'app montre n'est pas autonome : la source de vérité est la base Room du téléphone,
            et tous les appels sortants (Gemini, Calendar, Alexa) partent de `app`. La montre
            saisit et affiche, puis synchronise via la Data Layer (DEPLOYMENT.md §12).
            Déclarer `false` est aussi ce qui fait installer la montre depuis le téléphone.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

    </application>

</manifest>
