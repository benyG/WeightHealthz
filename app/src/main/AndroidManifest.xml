<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Les rappels sont le cœur du produit : sans cette permission, l'escalade est muette. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ForgeApplication"
        android:allowBackup="false"
        android:label="Forge"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forge">

        <!--
            ForgeApplication implémente Configuration.Provider pour fournir la HiltWorkerFactory :
            WorkManager s'initialise alors à la demande, à son premier usage. L'initialiseur
            automatique fourni par androidx.startup doit disparaître, sinon les deux se disputent
            l'initialisation et la fabrique Hilt n'est pas celle qui gagne.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Forge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reçoit les pesées saisies sur la montre (DEPLOYMENT.md §12). -->
        <service
            android:name=".wearlink.WearMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/forge" />
            </intent-filter>
        </service>

    </application>

</manifest>
